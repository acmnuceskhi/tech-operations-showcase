# Tina CMS Environment Variables
#
# For local development, these are optional - Tina will work without them.
# For production deployment (Tina Cloud), you must set these values.
#
# To get these values:
# 1. Sign up at https://app.tina.io
# 2. Connect your GitHub repository
# 3. Get your Client ID and Token from the Tina Cloud dashboard

# Your Tina Cloud Client ID
VITE_TINA_CLIENT_ID=your_client_id_here

# Your Tina Cloud Read-Only Token
VITE_TINA_TOKEN=your_token_here

# Git branch to use (usually 'main' or 'master')
VITE_TINA_BRANCH=main
